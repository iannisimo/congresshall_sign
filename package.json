{
  "name": "congresshall-sign",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Congress-hall sign: schedule and live room status on one screen, with an admin area",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=src/server --watch-path=src/shared --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "passwd": "node --disable-warning=ExperimentalWarning src/server/cli.ts passwd",
    "cli": "node --disable-warning=ExperimentalWarning src/server/cli.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
